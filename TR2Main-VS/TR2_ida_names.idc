#include <idc.idc>

static apply_name(ea, name, fallback)
{
    auto flags;
    flags = SN_NOCHECK | SN_NOWARN;
    if (set_name(ea, name, flags))
        return 1;
    if (set_name(ea, fallback, flags))
    {
        msg("Used %s at %X.\n", fallback, ea);
        return 1;
    }
    msg("Could not apply %s at %X.\n", name, ea);
    return 0;
}

